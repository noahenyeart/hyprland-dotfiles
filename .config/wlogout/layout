{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "hyprshutdown",
    "text" : "Logout",
    "keybind" : "e"
}

{
    "label" : "suspend",
    "action" : "systemctl suspend -i",
    "text" : "Suspend",
    "keybind" : "u"
}

{
    "label" : "hibernate",
    "action" : "systemctl hibernate -i",
    "text" : "Hibernate",
    "keybind" : "h"
}

{
    "label" : "shutdown",
    "action" : "systemctl poweroff --no-wall",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot --no-wall",
    "text" : "Reboot",
    "keybind" : "r"
}
